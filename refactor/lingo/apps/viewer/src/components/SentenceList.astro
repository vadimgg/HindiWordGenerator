---
/**
 * Sentence list with source/topic group headers.
 *
 * Responsible for: rendering group headers and delegating each sentence
 * to SentenceCard.
 *
 * Dependencies: SentenceCard.astro, types.ts (SentenceGroup).
 */
// Responsible for: grouped sentence list with group headers
import SentenceCard from './SentenceCard.astro';
import type { SentenceGroup } from '../utils/types';

interface Props { sentenceGroups: SentenceGroup[]; }
const { sentenceGroups } = Astro.props;

// Build a flat index across all groups for sentence IDs
let globalIndex = 0;
---

{sentenceGroups.map((group) => (
  <>
    <div class="flex items-center gap-2 px-1 pt-6 pb-2">
      <span class="font-title text-[10px] font-semibold uppercase tracking-widest text-zinc-500 shrink-0">
        {group.label}
      </span>
      <div class="flex-1 h-px bg-slate-800/60"></div>
      <span class="text-[10px] text-zinc-700 shrink-0">{group.sentences.length}</span>
    </div>
    {group.sentences.map((sentence) => {
      const idx = globalIndex++;
      return (
        <SentenceCard index={idx} {...sentence} />
      );
    })}
  </>
))}
