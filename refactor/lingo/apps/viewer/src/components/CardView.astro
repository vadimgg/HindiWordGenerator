---
import type { ViewerCard } from "../lib/api";

interface Props {
  card?: ViewerCard;
}

const { card } = Astro.props;
---

{
  card ? (
    <article class="card" data-card-id={card.id}>
      <h2 class="card__lead">{card.lead}</h2>
      {card.secondary && <p class="card__secondary">{card.secondary}</p>}
      <p class="card__english">{card.english}</p>
      <p class="card__literal">{card.literal}</p>
      <p class="card__meta">{card.register} · {card.id}</p>
      {card.audio_url && (
        <audio class="card__audio" controls preload="none" src={card.audio_url}>
          Your browser does not support audio playback.
        </audio>
      )}
    </article>
  ) : (
    <template id="card-view-template">
      <article class="card" data-card-id="">
        <h2 class="card__lead"></h2>
        <p class="card__secondary" hidden></p>
        <p class="card__english"></p>
        <p class="card__literal"></p>
        <p class="card__meta"></p>
        <audio class="card__audio" controls preload="none" hidden>
          Your browser does not support audio playback.
        </audio>
      </article>
    </template>
  )
}
