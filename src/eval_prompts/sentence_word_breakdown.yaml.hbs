task: sentence_word_breakdown
instructions: |
  Break each sentence into visible Hindi word occurrences. Do not include spaces
  or punctuation as entries. Include Hindi, roman, and meaning.

  Return YAML only:
  results:
    - id: "0001"
      words:
        - hindi: "..."
          roman: "..."
          meaning: "..."
items:
{{#each items}}
  - id: "{{id}}"
    hindi: "{{hindi}}"
    romanisation: "{{romanisation}}"
    english: "{{english}}"
{{/each}}
